<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<PackageId>Delta.Game.Resources.Overrides</PackageId>
		<Version>0.0.1</Version>
		<Authors>deltalazer</Authors>
		<Company>deltalazer</Company>
		<Description>Resource overrides for the Deltalazer project (Soft Launch - Alpha)</Description>
		<RepositoryUrl>https://github.com/deltalazer/delta-resources</RepositoryUrl>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Textures\**\*" />
	</ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="\" />
</Project>